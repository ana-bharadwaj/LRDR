# Ollama server (no API key required — it's local)
OLLAMA_BASE_URL=http://localhost:11434

# Pull before first run: ollama pull llama3.1
OLLAMA_LLM_MODEL=llama3.1

# Pull before first run: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chunking tuned for dense technical PDFs. Smaller chunk_size + proportional
# overlap raises retrieval precision at the cost of more chunks/embedding calls.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

RETRIEVAL_K=4
FAISS_INDEX_DIR=faiss_index
MAX_FILE_SIZE_MB=50

# Section-aware chunking: keeps chunks from spanning detected heading
# boundaries. Set to false to use pure character-count splitting.
SECTION_AWARE_CHUNKING=true

# Reranking: cross-encoder re-scores a wider FAISS candidate pool against the
# literal question before the final top RETRIEVAL_K go into the prompt.
# First run downloads the model (~90MB) and is slower; subsequent runs reuse it.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=12

# Answer caching: identical questions against an unchanged index skip the LLM.
# Cache is wiped automatically whenever that index is re-ingested.
CACHE_ENABLED=true
CACHE_DIR=answer_cache

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
